MODEL_PROVIDER=OpenAI
API_BASE=
API_KEY=
MODEL_NAME=
VISION_MODEL_NAME=deepseek-v4-flash-vision-exp
VISION_TEMPERATURE=0.2
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.2
LLM_SSL_VERIFY=false
# Frames sampled across the clip (motion-weighted, time-ordered).
VISION_MAX_FRAMES=12
# Extra frames sampled inside the windows the first pass asks to zoom into.
VISION_ZOOM_FRAMES=6
# Max number of zoom windows.
VISION_MAX_WINDOWS=3
VISION_MAX_WIDTH=768
# Cache sampled frames per video (keyed by path+mtime+size).
VISION_CACHE=true
# Vision provider: openai (default) or mock (offline, deterministic).
VISION_BACKEND=openai
# Only analyze the first N seconds (0 = whole clip); cheaper on long videos.
VISION_MAX_SECONDS=0
# Frames read while locating motion-heavy windows.
VISION_PROBE_BUDGET=64
# Retries per vision call (a timeout is applied from LLM_TIMEOUT).
LLM_RETRIES=2
# Model-driven analysis (the agent inspects windows itself). Slower.
AGENTIC_MODE=false
# Add lexically-retrieved past sessions to the report context.
RETRIEVAL=true
# Enable openjiuwen rails (token-budget guard; memory rail when EMBED_* set).
RAILS=true
# Capture usage for every model call via Runner.callback_framework.
TRACE_CALLBACKS=false
# Abort a run once cumulative tokens exceed this (0 = unlimited).
TOKEN_BUDGET=0
# Optional embeddings: enable the MemoryRail long-term memory.
EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL_NAME=text-embedding-v3
